# TickIt environment.
#
# Local dev:  copy to .env
# Pi:         copy to .env.prod and replace the secrets with 1Password refs
#             (op://Vault/Item/field), then `just prod-up`.

# --- Server ---------------------------------------------------------------
HOST=0.0.0.0
# 3002 by default.
PORT=3002
NODE_ENV=development

# Absolute path to the SQLite file. In the image this is /app/data/tickit.db,
# which is the SSD bind mount in production.
DATABASE_PATH=./data/tickit.db

# Directory of the built SPA the server serves for all non-/api routes.
# Set in the image; only needed locally if you serve a production build.
# CLIENT_DIST=./client/dist

# --- Compose (prod only) --------------------------------------------------
# Host directory backing /app/data. MUST be on the attached USB SSD, not the
# SD card — SD cards die outright under SQLite's write pattern.
DATA_DIR=/mnt/ssd/tickit

# --- Litestream -> Cloudflare R2 -----------------------------------------
# Leave LITESTREAM_REPLICA_BUCKET empty to disable replication entirely; the
# entrypoint then runs the server directly with no restore attempt.
LITESTREAM_REPLICA_BUCKET=
# Prefix inside the bucket. Must be unique per database if the same
# bucket is shared.
LITESTREAM_REPLICA_PATH=tickit
# Cloudflare R2: https://<account_id>.r2.cloudflarestorage.com (include https://)
LITESTREAM_REPLICA_ENDPOINT=
LITESTREAM_REPLICA_REGION=auto
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=

# --- Reminders (Web Push) -------------------------------------------------
# Generate a pair with: npm run vapid:generate --workspace=server
# Leave blank to run without reminders — the server boots normally and logs
# one line saying they are disabled.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
